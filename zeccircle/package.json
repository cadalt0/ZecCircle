{
  "name": "zeccircle",
  "version": "0.1.0",
  "private": true,
  "description": "Family spending circles on Telegram: an AI agent buys from Bitrefill within limits the circle owner sets.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@grammyjs/auto-retry": "2.0.2",
    "@grammyjs/runner": "2.0.3",
    "grammy": "1.46.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
