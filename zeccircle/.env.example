# --- Required -------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# From https://platform.claude.com
ANTHROPIC_API_KEY=
# Personal API key from https://www.bitrefill.com/account/developers
BITREFILL_API_KEY=

# --- Optional (defaults shown) --------------------------------------------
# NODE_ENV=development
# LOG_LEVEL=info

# ANTHROPIC_MODEL=claude-sonnet-5-5

# BITREFILL_BASE_URL=https://api.bitrefill.com/v2
# Business API keys only: include Bitrefill's free test products in search
# BITREFILL_INCLUDE_TEST_PRODUCTS=false

# SQLite file (directory is created on start)
# DATABASE_PATH=./data/zeccircle.db

# Currency every limit is expressed in. Must match your Bitrefill account currency.
# CIRCLE_CURRENCY=USD

# Defaults applied to new circles / newly approved members (in CIRCLE_CURRENCY)
# DEFAULT_CIRCLE_MONTHLY_LIMIT=10
# DEFAULT_MEMBER_PER_PURCHASE_LIMIT=2
# DEFAULT_MEMBER_MONTHLY_LIMIT=5

# Invite links expire after this many hours
# INVITE_TTL_HOURS=24
# Unconfirmed purchase proposals expire after this many minutes
# PROPOSAL_TTL_MINUTES=30
# Refuse to pay if the Bitrefill invoice is more than this % above the quote
# PRICE_TOLERANCE_PERCENT=5
# Max agent messages per user per minute
# AGENT_RATE_LIMIT_PER_MINUTE=8

# Test mode: fake catalogue + fake purchases, nothing is bought. Remove (or set to live) when you add BITREFILL_API_KEY.
BITREFILL_MODE=

# Zcash funding: mock = simulated wallet (/testdeposit). Switch to testnet after scripts/zcash-setup.sh
ZCASH_MODE=
ZCASH_SETTLEMENT_ADDRESS=

# Postgres (Neon). Paste your connection string, e.g. postgres://user:pass@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=

# --- Activity log (/circlelogs) ---
# Any circle owner can turn on logs for their OWN circle in a group/channel; no setup needed.
# Optional: bot admins (Telegram ids, comma-separated; send /whoami to the bot) can also follow EVERY circle
# with `/circlelogs all`, which also receives bot start/stop events.
ADMIN_TELEGRAM_IDS=

# --- PRODUCTION / MAINNET (real ZEC) ---
# To switch: set ZCASH_MODE=mainnet (BITREFILL_MODE must stay live) and fill in the email below.
# The mainnet wallet lives in ./data/zcash-mainnet-wallet (already created). Fund it with /fund.
BITREFILL_ACCOUNT_EMAIL=
# ONE_CLICK_API_KEY=
