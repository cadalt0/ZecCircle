# ZecCircle: configuration for MAINNET (real ZEC, real Bitrefill purchases).
# Copy this file to .env and fill in the blanks. Never commit .env (it is git-ignored).

# --- Required: keys and services -------------------------------------------
# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# From https://platform.claude.com
ANTHROPIC_API_KEY=
# Personal API key from https://www.bitrefill.com/account/developers
BITREFILL_API_KEY=
# Postgres connection string, e.g. from Neon: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
# The email of the Bitrefill account that owns the API key above. Swapped ZEC arrives there as USD store credit.
BITREFILL_ACCOUNT_EMAIL=

# --- Required: mainnet mode ------------------------------------------------
# live = real Bitrefill purchases. ZCASH_MODE=mainnet requires this.
BITREFILL_MODE=live
# mainnet = real ZEC, live ZEC price, purchases funded by a ZEC -> USDC -> Bitrefill credit swap.
ZCASH_MODE=mainnet

# --- Recommended -----------------------------------------------------------
# Explorer link shown in receipts; {txid} is replaced. (The default mainnet explorer may not index these transactions.)
ZCASH_EXPLORER_TX_URL=https://3xpl.com/zcash/transaction/{txid}
# Optional. Telegram ids (comma-separated) that may also follow EVERY circle with `/circlelogs all`.
# Circle owners do not need this: they turn on logs for their own circle with /circlelogs.
ADMIN_TELEGRAM_IDS=

# --- Optional (defaults shown) ---------------------------------------------
# NODE_ENV=development
# LOG_LEVEL=info
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Where the zcash-devtool binary is (see README step 3) and where the mainnet wallet is kept.
# ZCASH_DEVTOOL_PATH=../tools/bin/zcash-devtool
# ZCASH_WALLET_DIR=./data/zcash-mainnet-wallet
# Light-wallet server ("zecrocks" = zec.rocks) and connection ("direct", "tor" or "socks5://host:port", e.g. a Nym proxy).
# ZCASH_SERVER=zecrocks
# ZCASH_CONNECTION=direct
# Confirmations before a deposit counts. The wallet only spends other people's funds after 10, so keep this at 10.
# ZCASH_MIN_CONFIRMATIONS=10
# ZCASH_SYNC_INTERVAL_SECONDS=30
# Optional 1Click partner key (without it 1Click may charge a small extra fee).
# ONE_CLICK_API_KEY=

# Currency of all limits. Must match your Bitrefill primary balance (USD).
# CIRCLE_CURRENCY=USD
# Defaults for new circles and members, in CIRCLE_CURRENCY.
# DEFAULT_CIRCLE_MONTHLY_LIMIT=10
# DEFAULT_MEMBER_PER_PURCHASE_LIMIT=2
# DEFAULT_MEMBER_MONTHLY_LIMIT=5
# INVITE_TTL_HOURS=24
# PROPOSAL_TTL_MINUTES=30
# PRICE_TOLERANCE_PERCENT=5
# AGENT_RATE_LIMIT_PER_MINUTE=8
